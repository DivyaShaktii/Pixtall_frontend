# Public middleware origin used by browser requests. Vite embeds this at build time,
# so configure it in the hosting provider before building/redeploying the frontend.
VITE_SYSTEM_API_BASE_URL=https://pixtallmiddleware-production.up.railway.app

# Retained for compatibility with older frontend code. Current generation requests
# are submitted through VITE_SYSTEM_API_BASE_URL, not directly to the image backend.
VITE_API_BASE_URL=https://pixtallbackend-production-9ec3.up.railway.app
