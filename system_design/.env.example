# Use "production" for the real deployment. Development mode permits localhost CORS
# and is the only mode in which setup/dev_seed.py is allowed to run.
APP_ENV=development
# For local development, use your Railway TCP PROXY URL. In production, use the PRIVATE URL.
DATABASE_URL="postgresql+psycopg://postgres:replace_me_with_password@replace_me_with_tcp_proxy_domain:replace_me_with_port/railway"
AUTH_MODE=development
DEV_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=replace_me_with_generated_secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=1440
JWT_ISSUER=pixtall-api
JWT_AUDIENCE=pixtall-web
JWT_LEEWAY_SECONDS=30
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_me@gmail.com
SMTP_PASSWORD=replace_me_with_google_app_password
SMTP_FROM_EMAIL=replace_me@gmail.com
SMTP_FROM_NAME=Pixtall
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_VERIFICATION_CODE_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
PASSWORD_RESET_TOKEN_MINUTES=20
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
RAILWAY_BACKEND_URL=https://pixtallbackend-production-9ec3.up.railway.app/generate_image
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=300
BACKEND_MAX_ATTEMPTS=4
BACKEND_TIMEOUT_SECONDS=180
# Comma-separated exact browser origins (scheme + hostname + optional port).
# Do not include URL paths or trailing slashes. Add every deployed frontend origin.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADMIN_CREDIT_GRANTS_ENABLED=false
# Set true only after every Razorpay key, webhook secret, and recurring plan ID below
# has been configured in the same deployment environment.
BILLING_ENABLED=false
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_PLAN_CREATOR_ID=plan_replace_me
RAZORPAY_PLAN_PRO_ID=plan_replace_me
RAZORPAY_PLAN_BUSINESS_ID=plan_replace_me
# Separate Razorpay plans created with USD amounts for non-Indian subscriptions.
RAZORPAY_PLAN_CREATOR_USD_ID=plan_replace_me
RAZORPAY_PLAN_PRO_USD_ID=plan_replace_me
RAZORPAY_PLAN_BUSINESS_USD_ID=plan_replace_me
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=1200
CHECKOUT_BRAND=Pixtall by AI Vatika
GST_RATE_BPS=1800
