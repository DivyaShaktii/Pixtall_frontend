APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pixtall
AUTH_MODE=development
DEV_USER_ID=00000000-0000-0000-0000-000000000001
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
RAILWAY_BACKEND_URL=https://pixtallbackend-production-9ec3.up.railway.app/generate_image
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=300
BACKEND_MAX_ATTEMPTS=4
BACKEND_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ADMIN_CREDIT_GRANTS_ENABLED=false
